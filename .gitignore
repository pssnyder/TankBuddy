# .gitignore #
# This is the gitignore for the tankbuddy repo #
################################################

# Main Stuff #
#ignore all hidden (dot) files
.*
~*


# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Web Server Files #
####################
# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore other web server stuff
/cgi_bin*


# Other Stuff #
###############
# ignore private/secret files
*.der
*.key
*.pem
*.ssh
*.well-known*
sftp-config.json

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject


# Whitelist Files #
###################
!.gitignore
!.editorconfig
!.phpcs.xml.dist

